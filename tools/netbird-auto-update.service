[Unit]
Description=Refresh the NetBird container images (hourly)
Documentation=file:/opt/netbird/README.md
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/netbird-auto-update.sh
Nice=10
IOSchedulingClass=idle
# A slow GHCR pull must not be killed mid-flight by systemd's default timeouts.
# Kept above the script's own 90 min pull cap so the script decides; if a pull
# does need the full window the next hourly timer just skips (flock).
TimeoutStartSec=100min
